NODE_ENV=development
PORT=3000
# Backend가 Supabase PostgreSQL에 연결할 때 사용하는 Connection String입니다.
# 실제 값과 비밀번호는 저장소에 기록하지 않습니다.
DATABASE_URL=

# Supabase Auth Access Token 검증에 사용하는 프로젝트 URL입니다.
SUPABASE_URL=

# 공개 가능한 Supabase publishable key입니다. Secret/service-role key를 넣지 않습니다.
SUPABASE_PUBLISHABLE_KEY=

# 현재 runtime Deployment를 식별하는 값입니다. 실제 C Adapter 연결을 뜻하지 않습니다.
MIDNIGHT_NETWORK=fixture
MIDNIGHT_ADAPTER_PROFILE=

# packages/rule-draft의 Gemini 어댑터(src/providers/gemini.ts)가 사용하는 서버 전용 키입니다.
# 비어 있으면 PROVIDER_UNAVAILABLE로 처리되어 수기 입력 경로(manual_required)로 전환됩니다.
# 프론트 번들에 노출하지 않습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 기본 모델이 503(과부하)로 재시도까지 모두 실패했을 때 순서대로 1회씩 시도할 폴백 모델(쉼표 구분).
# 비워두면 gemini-3.7-flash,gemini-3.5-flash를 기본값으로 사용합니다.
GEMINI_FALLBACK_MODELS=
