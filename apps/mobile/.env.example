# Fresh clones use the local preview without any provider keys.
# For real Privy authentication, set both IDs for the same Privy app.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_MOBILE_CLIENT_ID=
# Set the team's Backend URL only for the authenticated flow.
# Native devices cannot reach this computer via localhost.
EXPO_PUBLIC_BACKEND_URL=
# Use privy only after configuring the app IDs and a reachable Backend.
EXPO_PUBLIC_AUTH_MODE=preview
