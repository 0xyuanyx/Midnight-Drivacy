{
  "name": "midnight-drivacy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@drivacy/backend",
    "dev:insurer": "npm run dev --workspace=@drivacy/web -- --port 5173 --strictPort",
    "dev:driver": "npm run start --workspace=@drivacy/mobile",
    "dev:driver-preview": "npm run web --workspace=@drivacy/mobile -- --port 8081",
    "dev:bridge": "node scripts/demo-bridge.mjs",
    "dev:linked": "node scripts/dev-linked.mjs",
    "mobile": "npm run start --workspace=@drivacy/mobile",
    "mobile:test": "npm run test --workspace=@drivacy/mobile --",
    "mobile:typecheck": "npm run typecheck --workspace=@drivacy/mobile",
    "mobile:export": "npm run export --workspace=@drivacy/mobile",
    "build:insurer": "npm run build --workspace=@drivacy/web",
    "build:driver-preview": "npm run export:web --workspace=@drivacy/mobile",
    "build": "npm run build --workspace=@drivacy/shared && npm run build --workspace=@drivacy/rule-draft && npm run build --workspace=@drivacy/backend",
    "typecheck": "npm run typecheck --workspace=@drivacy/shared && npm run typecheck --workspace=@drivacy/rule-draft && npm run typecheck --workspace=@drivacy/backend",
    "lint": "eslint .",
    "test": "npm run build --workspace=@drivacy/shared && npm run test --workspace=@drivacy/shared && npm run test --workspace=@drivacy/rule-draft && npm run test --workspace=@drivacy/backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
